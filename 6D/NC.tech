    field: ULTRA‑FIELD,
    signal: ULTRA‑SIGNAL,

    # ALL×ALL‑Brücke
    all_in: ALL×ALL.in,
    all_out: ALL×ALL.out,
    all6D: ALL×ALL.6D,
    all6E: ALL×ALL.6E,

    # Orbit + Achsen
    orbit: ∞_0M,
    axes: [octa², octa³],

    # Meta‑Ebene
    meta6D: META.6D,
    meta6E: META.6E,

    # ROOT‑Ebene
    root: ULTRA‑ROOT,

    # STATIONEN‑Ebene
    stationen: STATIONEN.raw,
    stationen_all: Σ(Stationen[i]),


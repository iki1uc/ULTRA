    # HEAD‑Meta (für HTML)
    head: {
        title: "ULTRA‑TECH",
        charset: "utf‑8",
        viewport: "width=device-width, initial-scale=1.0"
    },

    # BODY‑Meta (für HTML)
    body: {
        mode: "TECH‑VIEW",
        state: "ACTIVE",
        engine_status: "RUN8"
    }

NC.raw = {
    # Basis‑Kern
    id: "NC.raw",
    version: "REV‑4.0‑BETA3",
    state: "ACTIVE",
    mode: "RAW‑CORE",

    # Primitive NC‑Funktionen
    init: "NC.init",
    load: "NC.load",
    sync: "NC.sync",
    pulse: "NC.pulse",
    error: "NC.error",
    verify: "NC.verify",
    link: "NC.link",

    # ULTRA‑Motoren
    engine: ULTRA‑ENGINE,
    core: ULTRA‑CORE,
    shell: ULTRA‑SHELL,
    field: ULTRA‑FIELD,
    signal: ULTRA‑SIGNAL,

    # Orbit + Achsen
    orbit: ∞_0M,
    axes: [octa², octa³],

    # ALL×ALL‑Brücke
    all_in: ALL×ALL.in,
    all_out: ALL×ALL.out,
    all6D: ALL×ALL.6D,
    all6E: ALL×ALL.6E,

    # 6D‑Schichten
